datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  EMPLOYEE
  CLERK
  MANAGER
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  OUT_OF_SERVICE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PREPARING   
  READY
  COMPLETED
  CANCELLED
}


model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(EMPLOYEE)
  department    String?
  contactNumber String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  Active        Boolean   @default(true)
  
  sessions      Session[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  bookings      Booking[]     @relation("EmployeeBookings")
  preparedBookings Booking[]   @relation("PreparedBookings")
  stockAdjustments StockAdjustment[]
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         Int      @id @default(autoincrement())
  userId     Int
  jwtId      String   @unique
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  userId     Int
  tokenHash  String   @unique
  expiresAt  DateTime
  revoked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Room {
  id          Int        @id @default(autoincrement())
  name        String
  description String?
  capacity    Int
  status      RoomStatus @default(AVAILABLE)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  amenities RoomAmenity[]
  bookings  BookingRoom[]
}

model Amenity {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms RoomAmenity[]
  bookings BookingAmenity[]
}

model RoomAmenity {
  roomId     Int
  amenityId  Int

  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([roomId, amenityId])
}

model Booking {
  id           Int           @id @default(autoincrement())
  employeeId   Int
  preparedById Int?
  startAt      DateTime
  endAt        DateTime
  purpose      String
  status       BookingStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  employee     User          @relation("EmployeeBookings", fields: [employeeId], references: [id], onDelete: Cascade)
  preparedBy   User?         @relation("PreparedBookings", fields: [preparedById], references: [id])
  rooms        BookingRoom[]
  amenities    BookingAmenity[]
}

model BookingRoom {
  id         Int      @id @default(autoincrement())
  bookingId  Int
  roomId     Int
  roomStatus String   @default("BOOKED")

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model BookingAmenity {
  bookingId  Int
  amenityId  Int

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([bookingId, amenityId])
}

model ConsumableItem {
  id              Int      @id @default(autoincrement())
  name            String
  unit            String
  quantityOnHand  Int
  reorderLevel    Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  adjustments StockAdjustment[]
}

model StockAdjustment {
  id              Int      @id @default(autoincrement())
  itemId          Int
  adjustedById    Int
  quantityChange  Int
  reason          String
  createdAt       DateTime @default(now())

  item            ConsumableItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  adjustedBy      User           @relation(fields: [adjustedById], references: [id], onDelete: Cascade)
}


