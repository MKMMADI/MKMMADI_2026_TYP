# Copy to .env and set to your machine's LAN IP (not localhost) when using a physical device.
# Android emulator can use 10.0.2.2; iOS simulator can use localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000

# Comma-separated browser origins allowed to open production realtime sockets.
SOCKET_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081
