{
  "name": "2026_typ",
  "version": "1.0.0",
  "description": "API for Project 2026_TYP (Node + Express)",
  "main": "dist/server.js",
  "scripts": {
    "preinstall": "npx npm-force-resolutions",
    "start": "node dist/server.js",
    "dev": "tsx watch src_ts/server.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "build": "tsc",
    "prebuild": "npm test",
    "seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.10.0",
    "approve": "^0.0.12",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "prisma": "^7.10.0",
    "scripts": "^0.1.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.5.0",
    "npm-force-resolutions": "^0.0.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "type": "commonjs",
  "allowScripts": {
    "prisma@8.0.0-rc.13": true,
    "@prisma/engines@8.0.0-rc.13": true,
    "esbuild": true,
    "msgpackr-extract": true,
    "workerd": true
  },
  "resolutions": {
    "hono": "4.14.0",
    "@hono/node-server": "1.20.0",
    "lodash": "4.17.21",
    "valibot": "1.5.0",
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.24.0"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
