{
  "name": "2026_TYP",
  "version": "1.0.0",
  "description": "API for Project 2026_TYP (Node + Express)",
  "main": "dist/server.js",
  "scripts": {
    "preinstall": "npx npm-force-resolutions",
    "start": "node dist/server.js",
    "dev": "tsx watch src_ts/server.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "build": "tsc",
    "prebuild": "npm test",
    "seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^5.4.2",
    "npm-force-resolutions": "^0.0.10"
  },
  "resolutions": {
    "deepmerge-ts": "8.0.0",
    "mysql2": "3.24.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true
