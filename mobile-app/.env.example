# Copy this file to .env in the same folder (mobile-app/.env).
# Use your machine's LAN IP so a physical device or emulator can reach the API.
# Android emulator: http://10.0.2.2:4000
# iOS simulator:    http://localhost:4000
# Physical device / WSL / LAN: http://YOUR_HOST_IP:4000
#
# Do NOT append /api/v1 — the app adds that path itself.
EXPO_PUBLIC_API_URL=http://172.30.128.1:4000

# After editing .env, restart Expo with a cleared cache:
#   npx expo start -c
