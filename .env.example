# Copy to .env and replace every placeholder before starting Compose.
# Use a URL-safe password (letters, digits, hyphens) so it can appear in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-url-safe-password
DATABASE_URL=postgresql://postgres:replace-with-url-safe-password@db:5432/2026_TYP_Conference_Bookings_v1?schema=public
JWT_SECRET=replace-with-a-long-random-secret
