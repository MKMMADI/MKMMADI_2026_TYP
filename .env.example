# Copy to .env and replace every placeholder before starting Compose.
# Connect to PostgreSQL on the Windows host from Docker Desktop.
# URL-encode any special characters in the password portion of DATABASE_URL.
DATABASE_URL=postgresql://postgres:replace-with-url-encoded-password@host.docker.internal:5432/2026_TYP_Conference_Bookings_v1?schema=public
JWT_SECRET=replace-with-a-long-random-secret
SOCKET_ALLOWED_ORIGINS=http://localhost:8081
